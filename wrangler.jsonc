{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat-tg",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "index.js",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "AI_CHAT_KV"
    }
  ]
}